# Copia este archivo como .env y rellena los valores

# --- Gemini (lee las facturas) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Respaldo si el principal está saturado
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# --- Marca que se ve en el panel ---
# BRAND_NAME=Gastos
# Nombre de la empresa a la que se hace la demo (aparece en la cabecera)
# CLIENT_NAME=Acme Ingeniería

# --- WhatsApp (Baileys) ---
# La vinculación se hace escaneando el QR del panel: no hace falta ninguna clave.
# true = cualquiera que escriba queda dado de alta (demo); false = solo empleados registrados en el panel
# ALLOW_ANY_SENDER=true
# Registros internos de Baileys (silent, info, debug)
# BAILEYS_LOG=silent

# --- Panel ---
# PORT=3000

# --- Opcional: WhatsApp Business Cloud API (Meta), para producción con `npm run bot:meta` ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WEBHOOK_PORT=3001
