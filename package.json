  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch-path=src --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "extract": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/extract-file.js",
    "bot:meta": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/bot.js",
    "reset": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/reset.js"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
